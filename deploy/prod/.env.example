SYNORA_ENV=production

SYNORA_BOOTSTRAP_EMAIL=han.teacher@example.com
SYNORA_BOOTSTRAP_PASSWORD=change-me
SYNORA_BOOTSTRAP_DISPLAY_NAME=韩老师

SYNORA_NOTIFICATION_FROM_EMAIL=you@example.com
SYNORA_NOTIFICATION_TO_EMAIL=you@example.com
SYNORA_SMTP_HOST=smtp.example.com
SYNORA_SMTP_PORT=587
SYNORA_SMTP_USERNAME=
SYNORA_SMTP_PASSWORD=
SYNORA_SMTP_USE_TLS=true
SYNORA_WECOM_ROBOT_WEBHOOK=

SYNORA_LLM_API_KEY=
